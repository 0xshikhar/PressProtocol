{
  "name": "anonpress-extension",
  "displayName": "AnonPress",
  "version": "1.0.0",
  "description": "Browser extension for censorship-resistant content access via AnonPress network",
  "author": "AnonPress Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "^0.88.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "^4.0.1",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "manifest": {
    "host_permissions": [
      "http://localhost:4000/*",
      "https://*.pinata.cloud/*",
      "https://*.anonpress.io/*"
    ],
    "permissions": [
      "storage",
      "tabs"
    ]
  }
}
