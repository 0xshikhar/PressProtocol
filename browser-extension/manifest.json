{
  "manifest_version": 3,
  "name": "AnonPress",
  "version": "1.0.0",
  "description": "Browser extension for censorship-resistant content access via AnonPress network",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*.pinata.cloud/*",
    "https://*.anonpress.io/*",
    "https://anonpress-2we663lev-linux369s-projects.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
