{
  "name": "@pressprotocol/sdk",
  "version": "1.0.6",
  "description": "PressProtocol Headless Developer SDK and Terminal CLI - Censorship-Resistant Publishing & Multi-Transport Resolution",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pressprotocol": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin/cli.js 2>/dev/null || true",
    "cli": "tsx src/bin/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pressprotocol",
    "sdk",
    "ipfs",
    "tor",
    "ed25519",
    "cryptography",
    "sovereign-publishing",
    "censorship-resistance"
  ],
  "author": "0xShikhar",
  "license": "MIT",
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5"
  }
}
