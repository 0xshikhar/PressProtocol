{
  "name": "@pressprotocol/proof",
  "version": "1.0.0",
  "description": "Deterministic In-Browser CIDv1 Multihash & Air-Gapped .pressproof.json Cryptographic Codec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
