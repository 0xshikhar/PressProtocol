# ==============================================================================
# PressProtocol Sovereign Node Daemon Configuration (.env.example)
# Copy to .env and configure for your local or production environment
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production
DATA_DIR=/data

# Database (PostgreSQL / Prisma Accelerate)
# Leave empty for pure memory/ephemeral mode, or provide a postgres connection string:
DATABASE_URL=postgresql://user:password@localhost:5432/pressprotocol?schema=public

# IPFS Pinning Service (Optional Hybrid Fallback)
# If omitted, the node operates in pure sovereign mode with embedded Helia IPFS DHT
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Tor Hidden Service & SOCKS5 Configuration
TOR_ENABLED=true
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# CORS Configuration (Comma-separated allowed clearnet origins)
CORS_ORIGIN=https://pressprotocol.com,http://localhost:3000

# Operator authentication
# API key for node administration (federation, policy, peers, webhooks, bridge, custodial publish).
# If unset, a random admin key is generated and printed once at startup; manage via the key service.
ADMIN_API_KEY=

# Public URLs used in generated links (no localhost defaults in responses)
PUBLIC_NODE_URL=
PUBLIC_APP_URL=https://pressprotocol.com

# Gossip federation: accept unsigned gossip announcements (not recommended)
ALLOW_UNSIGNED_GOSSIP=false
