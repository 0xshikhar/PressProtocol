{
  "name": "anonpress-backend",
  "version": "1.1.0",
  "description": "AnonPress Backend API - Fastify server for content publishing, IPFS storage, Tor integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --no-engine",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "anonpress",
    "ipfs",
    "tor",
    "censorship-resistant",
    "decentralized"
  ],
  "author": "OxShikhar",
  "license": "MIT",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.1",
    "@helia/json": "^5.0.1",
    "@helia/unixfs": "^6.0.1",
    "@libp2p/bootstrap": "^12.0.6",
    "@libp2p/identify": "^4.0.5",
    "@libp2p/kad-dht": "^16.0.5",
    "@libp2p/tcp": "^11.0.5",
    "@libp2p/websockets": "^10.0.6",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "blockstore-core": "^6.1.1",
    "datastore-core": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "helia": "^5.5.1",
    "libp2p": "^2.10.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "socks-proxy-agent": "^8.0.4",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
