generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime? @updatedAt

  // Minimal profile - no personal data
  username String? @unique // Optional pseudonym
  avatar   String? // IPFS hash only
  NFTid    String? // Privy NFT ID for auth

  // Relations
  identities Identity[]
  contents   Content[] // Optional relation - for authenticated publishing

  @@index([walletAddress])
}

model Identity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  publicKey String   @unique // Ed25519 public key
  createdAt DateTime @default(now())
  
  // Store IPNS name for persistent identity (optional)
  ipnsName  String?  @unique // /ipns/k51... for permanent publisher identity

  @@index([userId])
  @@index([publicKey])
  @@index([ipnsName])
}

// Content metadata cache - NOT source of truth
// Source of truth: IPFS (immutable, decentralized)
// This table: Acceleration layer for discovery and routing
model Content {
  id        String   @id @default(cuid())
  cid       String   @unique // IPFS CID - THE source of truth
  
  // Cached metadata for fast discovery (fetched from IPFS)
  title     String
  tags      String[] // Array of tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Publisher info - ANONYMOUS by default
  publisherPubKey String // Ed25519 public key only
  userId          String? // Optional - for authenticated users only
  user            User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Cryptographic signature (also stored in IPFS manifest)
  signature String // Ed25519 signature of content

  // Relations
  mirrors Mirror[]

  @@index([cid])
  @@index([publisherPubKey])
  @@index([userId])
  @@index([createdAt])
  @@index([tags])
}

model Mirror {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  type      String // "ipfs", "tor", "gateway"
  url       String
  available Boolean  @default(true)
  latency   Int? // in milliseconds
  lastCheck DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([type])
}
