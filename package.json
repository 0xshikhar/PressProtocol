{
  "name": "pressprotocol-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:node": "./scripts/dev.sh --node",
    "dev:web": "./scripts/dev.sh --web",
    "build": "pnpm --recursive run build",
    "test": "./scripts/test.sh",
    "package:extension": "./scripts/package-extension.sh",
    "package:wordpress": "./scripts/package-wordpress.sh",
    "package:all": "./scripts/package-extension.sh && ./scripts/package-wordpress.sh",
    "worker:login": "pnpm --filter pressprotocol-worker run login",
    "worker:secret:jwt": "pnpm --filter pressprotocol-worker run secret:jwt",
    "worker:secret:db": "pnpm --filter pressprotocol-worker run secret:db",
    "worker:dev": "pnpm --filter pressprotocol-worker run dev",
    "worker:deploy": "pnpm --filter pressprotocol-worker run deploy",
    "pressprotocol": "pnpm --filter @pressprotocol/sdk run cli",
    "gh:pr:status": "gh pr status",
    "gh:pr:view": "gh pr view",
    "gh:pr:checks": "gh pr checks",
    "gh:issue:list": "gh issue list"
  },
  "engines": {
    "node": ">=22.23.3",
    "pnpm": ">=10.0.0"
  }
}
