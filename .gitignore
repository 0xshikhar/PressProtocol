.vercel

# Environment files (use backend/.env instead)
.env
.env.local
.env.*.local

# Docker files (root-level only, preserve core/node/docker-compose.yml)
/docker-compose.yml
/docker-compose.override.yml
!core/node/docker-compose.yml

node_modules

# Build outputs (tsc / Next.js) — regenerated via pnpm build, never committed
dist/
.next/
*.tsbuildinfo
coverage/

# SDK artifacts
__pycache__/
*.pyc
target/
**/target/
.DS_Store

# Cloudflare Worker secrets & test outputs
.dev.vars
.dev.vars.*
!.dev.vars.example
dist-test/
**/dist-test/
.wrangler/
core/worker/.dev.vars*
!core/worker/.dev.vars.example
core/worker/dist-test/