# AnonPress Environment Variables
# Copy this file to .env and fill in your values

# Database - Prisma Postgres (Fully Managed Cloud Database)
# Get your DATABASE_URL from: https://console.prisma.io
# This should be added to backend/.env file
# DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key

# Pinata IPFS Configuration
# Get your free API keys at https://pinata.cloud
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_here

# JWT Secret (generate a random string)
# Example: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_at_least_32_characters_long

# Optional: Custom IPFS Gateway
# IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Optional: Custom Tor Configuration
# TOR_PROXY_HOST=localhost
# TOR_PROXY_PORT=9050
# TOR_CONTROL_PORT=9051
# TOR_CONTROL_PASSWORD=your_tor_password
