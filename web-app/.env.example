# Web App Configuration (Frontend Only - No Database)
# Database is in the backend (anonpress-backend)

# App URL (your frontend URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL
# Production: https://anonpress-production.up.railway.app
# Development: http://localhost:4000
# Leave empty to auto-detect based on NODE_ENV
NEXT_PUBLIC_BACKEND_API_URL=